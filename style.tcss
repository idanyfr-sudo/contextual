Screen {
    align: center middle;
    background: $surface;
    color: $text;
    width: 50%;
}

#log {
    width: 60%;
    height: 12;
    border: round purple;
    background: $boost;
    scrollbar-size: 0 0;
    text-overflow: fold;
    text-wrap: wrap;
    text-style: italic;
}
#input {
    width: 60%;
    height: 3;
    border: round purple;
    background: $boost;
}

#input:focus {
    border: round $accent;
}

#InputPath{
    width: 60%;
    border: round purple;
    height: 3;
    background: $boost;
}